{
  "name": "brilho-minas-fila-financeiro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Fila do financeiro da Brilho Minas: regra de crédito da Marta e visão por perfil",
  "scripts": {
    "mascarar": "tsx scripts/mascarar.ts",
    "gerar": "tsx scripts/gerar.ts",
    "dev": "npm run gerar && vite",
    "build": "tsx scripts/build.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
